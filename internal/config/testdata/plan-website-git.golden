project example-site
1. backup timeout=30m0s free=true
   dir: /srv/example/site
   env_file: /srv/example/site/.env
   backup: command="tar -C /srv/example/site -czf /srv/example/backups/site.tar.gz public" volume="" keep=5 restore=""
2. git-checkout timeout=2m0s free=false
   dir: /srv/example/site
   env_file: /srv/example/site/.env
   tag: v1.3.0
3. command timeout=15m0s free=true
   dir: /srv/example/site
   env_file: /srv/example/site/.env
   shell: cd '/srv/example/site' && 'scripts/build.sh' 'v1.3.0'
4. compose-up timeout=5m0s free=false
   dir: /srv/example/site
   env_file: /srv/example/site/.env
   services: []
5. check-http timeout=1m0s free=false
   dir: /srv/example/site
   env_file: /srv/example/site/.env
   url: https://www.example.com/
   status: 200
   contains: "Example"
